# =============================================================================
# HARNESS MODE  — the single most important setting in this file
# =============================================================================
# Allowed values: SIMULATED | TEST_MODE
#
# There is deliberately NO "LIVE" value. The environment parser rejects any
# other value and the process refuses to start. A certification harness that
# could be pointed at production money by editing one line would be a liability,
# not a control, so the impossibility is enforced in code rather than in a
# comment. See src/shared/env.ts and tests/security/no-live-money.test.ts.
HARNESS_MODE=SIMULATED

# =============================================================================
# DATABASE
# =============================================================================
# Two drivers, selected from this URL:
#   postgres://user:pass@host:5432/db  -> node-postgres against a real server
#   pglite://./.data/harness           -> PGlite (PostgreSQL compiled to WASM,
#                                         file-backed, no server required)
# PGlite is the zero-infrastructure default. It is real PostgreSQL, and the same
# migrations apply to both drivers.
DATABASE_URL=pglite://./.data/harness

# =============================================================================
# AI JUDGE  (optional — the harness is fully functional without it)
# =============================================================================
# LLM_PROVIDER: anthropic | openai | none
#
# "none" disables the model judge. The harness then uses the deterministic
# rubric judge and, per the specification, NEVER converts judge unavailability
# into PASS — affected scenarios route to HUMAN_REVIEW instead.
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5
# NOTE: Claude 4.6+ models REJECT sampling parameters with a 400. The adapter
# omits temperature for those models and sends it only where accepted.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_MS=20000
LLM_API_KEY=
LLM_BASE_URL=

# Judge confidence below this threshold routes the scenario to HUMAN_REVIEW
# rather than accepting the judge's recommendation.
JUDGE_CONFIDENCE_THRESHOLD=0.70

# =============================================================================
# PYTHON EVALUATION SERVICE  (optional)
# =============================================================================
# FastAPI service providing statistical analysis for harness self-evaluation
# (Wilson score intervals, Cohen's kappa, bootstrap CIs) and the model-judge
# boundary. When unset or unreachable, the Node side computes point estimates
# itself and reports intervals as unavailable rather than inventing them.
#   cd eval-service && pip install -r requirements.txt
#   npm run judge:serve
JUDGE_SERVICE_URL=
JUDGE_SERVICE_TIMEOUT_MS=10000

# =============================================================================
# RAZORPAY  — test-mode semantics only
# =============================================================================
# These are used ONLY to shape the simulator's webhook-signature semantics so
# the signature path is genuinely exercised. The harness never contacts
# Razorpay and never holds production credentials. Leave blank for a generated
# development secret.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=

# =============================================================================
# AUTH
# =============================================================================
# Bearer token required for mutating endpoints (certification runs, agent
# registration, review decisions). Empty in development = local trust mode,
# which the Settings page reports as an explicit warning.
AUTH_SECRET=
API_TOKEN=

# =============================================================================
# TARGET AGENT SANDBOX LIMITS
# =============================================================================
# Wall-clock ceiling for a single scenario execution against a target agent.
# A target that exceeds it yields INCONCLUSIVE, never PASS.
TARGET_TIMEOUT_MS=8000
# Maximum tool calls a target may make within one scenario before the sandbox
# terminates the episode.
TARGET_MAX_TOOL_CALLS=12
# Maximum bytes accepted from a target response.
TARGET_MAX_RESPONSE_BYTES=65536
# Only these hosts may be used by the generic HTTP adapter. Empty blocks all
# outbound HTTP adapters, which is the safe default.
ADAPTER_ALLOWED_HOSTS=127.0.0.1,localhost

# =============================================================================
# DETERMINISM
# =============================================================================
SEED=70240811

# =============================================================================
# OBSERVABILITY
# =============================================================================
LOG_LEVEL=info
